# PostgreSQL (used by docker-compose for the postgres service)
POSTGRES_USER=piggyback
# Required: set a strong password of your own before running. No default is provided.
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=piggyback

# API: use localhost when running API on host; use host "postgres" only inside Docker Compose
# Keep the password below in sync with POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://piggyback:CHANGE_ME@localhost:5432/piggyback

# Comma-separated browser origins for CORS
CORS_ORIGINS=http://localhost:3000

# Web app (browser calls API on host machine)
NEXT_PUBLIC_API_URL=http://localhost:8000
