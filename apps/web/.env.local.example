# URL of the Piggyback API (FastAPI service)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Admin API key — used for all write operations from the browser UI.
# Set ADMIN_API_KEY in the API service to the same value.
# This key is exposed in the browser; only run locally or on a private network.
NEXT_PUBLIC_ADMIN_API_KEY=your-admin-key-here
